// measures.dax - all report measures.
// Power BI Desktop > DAX query view > paste this whole file > Run, then click
// "Update model: Add new measures" (or the CodeLens "Update model" above each MEASURE).
// Measures land on fact_scorecard; move them to a display folder if you like.
// Names differ from the table's columns (value, flag) because DAX names are case-insensitive.
// Relationships needed first (Model view, single direction, many-to-one):
//   fact_scorecard[hospital_id]       -> dim_hospital[hospital_id]
//   fact_scorecard[indicator_code]    -> dim_indicator[indicator_code]
//   fact_scorecard[fiscal_year_start] -> dim_year[fiscal_year_start]
//   ontario_benchmark[indicator_code]    -> dim_indicator[indicator_code]
//   ontario_benchmark[fiscal_year_start] -> dim_year[fiscal_year_start]

DEFINE
    // ---------- base ----------
    MEASURE fact_scorecard[Hospital Value] = AVERAGE ( fact_scorecard[value] )
    MEASURE fact_scorecard[CI Lower] = AVERAGE ( fact_scorecard[ci_lower] )
    MEASURE fact_scorecard[CI Upper] = AVERAGE ( fact_scorecard[ci_upper] )
    MEASURE fact_scorecard[Ontario Value] = AVERAGE ( ontario_benchmark[ontario_value] )
    MEASURE fact_scorecard[Flag Label] = SELECTEDVALUE ( fact_scorecard[flag] )
    MEASURE fact_scorecard[Worse Flags] = SUM ( fact_scorecard[is_worse] ) + 0
    MEASURE fact_scorecard[Selected Year] = SELECTEDVALUE ( dim_year[fiscal_year_label], "multiple years" )

    // ---------- headline ----------
    MEASURE fact_scorecard[Hospitals] = DISTINCTCOUNT ( fact_scorecard[hospital_id] )
    MEASURE fact_scorecard[Hospitals Flagged 1+] =
        COUNTROWS (
            FILTER ( VALUES ( dim_hospital[hospital_id] ),
                     CALCULATE ( [Worse Flags], REMOVEFILTERS ( dim_indicator ) ) >= 1 ) ) + 0
    MEASURE fact_scorecard[Hospitals Flagged 2+] =
        COUNTROWS (
            FILTER ( VALUES ( dim_hospital[hospital_id] ),
                     CALCULATE ( [Worse Flags], REMOVEFILTERS ( dim_indicator ) ) >= 2 ) ) + 0
    MEASURE fact_scorecard[Headline] =
        FORMAT ( [Hospitals Flagged 2+], "0" ) & " of " & FORMAT ( [Hospitals], "0" )
            & " Ontario hospital corporations are worse than the provincial value on two or more of the three indicators in "
            & [Selected Year] & ", and " & FORMAT ( [Hospitals Flagged 1+], "0" ) & " on at least one."

    // ---------- KPI cards (Ontario, vs previous year) ----------
    MEASURE fact_scorecard[Ontario Value PY] =
        VAR y = SELECTEDVALUE ( dim_year[fiscal_year_start] )
        RETURN CALCULATE ( [Ontario Value], REMOVEFILTERS ( dim_year ), dim_year[fiscal_year_start] = y - 1 )
    MEASURE fact_scorecard[Ontario Change vs PY] = [Ontario Value] - [Ontario Value PY]
    MEASURE fact_scorecard[Ontario Change Label] =
        VAR c = [Ontario Change vs PY]
        RETURN IF ( ISBLANK ( c ), BLANK (),
                    IF ( c > 0, "▲ ", IF ( c < 0, "▼ ", "■ " ) ) & FORMAT ( ABS ( c ), "0.0" ) & " vs previous year" )
    MEASURE fact_scorecard[Ontario Change Color] =      // lower is better on all 3 indicators
        VAR c = [Ontario Change vs PY]
        RETURN SWITCH ( TRUE (), ISBLANK ( c ), "#6B7280", c > 0, "#B42318", c < 0, "#1E7B4A", "#6B7280" )

    // ---------- scorecard table: one column per indicator ----------
    MEASURE fact_scorecard[Readmission] = CALCULATE ( [Hospital Value], dim_indicator[indicator_code] = "READMIT", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[ED Hours] = CALCULATE ( [Hospital Value], dim_indicator[indicator_code] = "ED90", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[Sepsis] = CALCULATE ( [Hospital Value], dim_indicator[indicator_code] = "SEPSIS", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[Flag Color] =
        SWITCH ( [Flag Label], "Worse", "#B42318", "Better", "#1E7B4A", "#1F2937" )
    MEASURE fact_scorecard[Readmission Color] = CALCULATE ( [Flag Color], dim_indicator[indicator_code] = "READMIT", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[ED Hours Color] = CALCULATE ( [Flag Color], dim_indicator[indicator_code] = "ED90", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[Sepsis Color] = CALCULATE ( [Flag Color], dim_indicator[indicator_code] = "SEPSIS", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[Total Worse Flags] = CALCULATE ( [Worse Flags], REMOVEFILTERS ( dim_indicator ), dim_year[is_latest] = TRUE () )

    // ---------- trend page ----------
    MEASURE fact_scorecard[Selected Hospital] =
        SELECTEDVALUE ( dim_hospital[hospital_name], "Pick one hospital" )
    MEASURE fact_scorecard[Trend Title] =
        [Selected Hospital] & " vs Ontario, " & SELECTEDVALUE ( dim_indicator[short_name] )

    // ---------- trend charts (single-page dashboard) ----------
    // Blank unless exactly one hospital is selected (a table row clicked), so the chart
    // never shows the average of all 65 hospitals as if it were one hospital.
    MEASURE fact_scorecard[Hospital Line] =
        IF ( HASONEVALUE ( dim_hospital[hospital_name] ), [Hospital Value] )
    MEASURE fact_scorecard[Hospital CI Lower] =
        IF ( HASONEVALUE ( dim_hospital[hospital_name] ), [CI Lower] )
    MEASURE fact_scorecard[Hospital CI Upper] =
        IF ( HASONEVALUE ( dim_hospital[hospital_name] ), [CI Upper] )

    // ---------- v2 polish: KPI card label + table cell colours ----------
    MEASURE fact_scorecard[Flagged Value] =
        FORMAT ( [Hospitals Flagged 2+], "0" ) & " of "
            & FORMAT ( CALCULATE ( [Hospitals], REMOVEFILTERS ( dim_year ), REMOVEFILTERS ( dim_indicator ) ), "0" )
    MEASURE fact_scorecard[Flagged Sub Label] = FORMAT ( [Hospitals Flagged 1+], "0" ) & " flagged on at least one"
    // Light cell background behind each value (blank = no colour, so "Similar" stays white)
    MEASURE fact_scorecard[Flag Bg] = SWITCH ( [Flag Label], "Worse", "#FDECEC", "Better", "#E7F5EC" )
    MEASURE fact_scorecard[Readmission Bg] = CALCULATE ( [Flag Bg], dim_indicator[indicator_code] = "READMIT", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[ED Hours Bg] = CALCULATE ( [Flag Bg], dim_indicator[indicator_code] = "ED90", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[Sepsis Bg] = CALCULATE ( [Flag Bg], dim_indicator[indicator_code] = "SEPSIS", dim_year[is_latest] = TRUE () )
    MEASURE fact_scorecard[Flags Color] = IF ( [Total Worse Flags] >= 2, "#B42318", "#334155" )

// Quick test: latest year headline numbers. Expect 7, 27, 65 for 2025-26.
EVALUATE
    CALCULATETABLE (
        ROW ( "Flagged 2+", [Hospitals Flagged 2+], "Flagged 1+", [Hospitals Flagged 1+], "Hospitals", [Hospitals] ),
        dim_year[is_latest] = TRUE ()
    )
