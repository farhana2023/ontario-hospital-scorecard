{
  "name": "Ontario Scorecard v2",
  "dataColors": [
    "#2563EB",
    "#94A3B8",
    "#E08A00",
    "#7C3AED",
    "#0E9AA7",
    "#B42318",
    "#1E7B4A",
    "#12304F"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F2A44",
  "tableAccent": "#0F2A44",
  "good": "#1E7B4A",
  "neutral": "#6B7280",
  "bad": "#B42318",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#12304F"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#12304F"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#475569"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#12304F"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "titleShow": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "titleShow": false,
            "gridlineColor": {
              "solid": {
                "color": "#EEF2F7"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": true,
            "markerSize": 5
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "rowPadding": 5,
            "outlineColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#0F2A44"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColorPrimary": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 11
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    }
  }
}